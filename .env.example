# Kit (ConvertKit) — required for the /pack email gate + exit-intent popup.
# Server-side only (used by src/app/api/subscribe/route.ts); no NEXT_PUBLIC_ prefix needed.
# Get these from https://app.kit.com → Settings → Developer (API Key) and the form/tag URLs.
KIT_API_KEY=
KIT_FORM_ID=
# Optional: numeric id of the "pack-v1" tag. If omitted, set the tag on the
# form itself in the Kit UI so every subscriber is tagged pack-v1 anyway.
KIT_TAG_ID=
